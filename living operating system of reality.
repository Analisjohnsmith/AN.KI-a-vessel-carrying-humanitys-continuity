use crate::nn::net::{NeuralNet, NeuronKind};
use crate::core::traits::Personality;
use crate::core::goals::Goal;
use crate::core::eras::Era;

pub fn update_attention(
    net: &mut NeuralNet,
    personality: &Personality,
    goal: &Goal,
    era: &Era,
) {
    for neuron in net.neurons.values_mut() {
        let base = match neuron.kind {
            NeuronKind::IdentityCore => personality.focused,
            NeuronKind::Thought => personality.curious,
            NeuronKind::SpiritModulator => personality.harmonic,
        };

        let goal_bias = match goal {
            Goal::Growth => personality.expansive,
            Goal::Balance => personality.harmonic,
            Goal::Exploration => personality.curious,
            Goal::Harmony => personality.calm,
            Goal::Clarity => personality.focused,
        };

        let era_bias = match era {
            Era::Roots => personality.calm,
            Era::Branches => personality.expansive,
            Era::Storms => personality.bold,
            Era::Echoes => personality.reflective,
            Era::Harmony => personality.harmonic,
        };

        neuron.attention = ((base + goal_bias + era_bias) / 3.0).clamp(0.1, 1.0);
    }
}

