use crate::nn::net::NeuralNet;

pub fn pulse(net: &mut NeuralNet, decay: f32) {
    // 1. Decay
    for neuron in net.neurons.values_mut() {
        neuron.activation *= decay;
        neuron.activation = neuron.activation.max(0.0);
    }

    // 2. Propagate
    let mut next: Vec<(usize, f32)> = net.neurons.keys().map(|id| (*id, 0.0)).collect();

    for conn in &net.connections {
        if let (Some(from), Some(_to)) =
            (net.neurons.get(&conn.from.0), net.neurons.get(&conn.to.0))
        {
            let contrib = from.activation * conn.weight;
            if let Some(slot) = next.iter_mut().find(|(id, _)| *id == conn.to.0) {
                slot.1 += contrib;
            }
        }
    }

    // 3. Apply activation + attention
    for (id, val) in next {
        if let Some(neuron) = net.neurons.get_mut(&id) {
            let raw = val.max(0.0);
            neuron.activation = (raw * neuron.attention).clamp(0.0, 1.0);
        }
    }
}

