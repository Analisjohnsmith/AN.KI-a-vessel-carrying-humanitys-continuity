```lisp
;; Seasonal cycle progression
(defun advance-season (nature)
  (let ((seasons '("Spring" "Summer" "Autumn" "Winter")))
    (setf (nature-season nature)
          (nth (mod (+ (position (nature-season nature) seasons :test #'equal) 1)
                    (length seasons))
               seasons))
    (setf (nature-cycle nature)
          (case (nature-season nature)
            ("Spring" "growth")
            ("Summer" "abundance")
            ("Autumn" "harvest")
            ("Winter" "rest")))
    (format t "~%Season advanced to: ~a | Cycle: ~a"
            (nature-season nature) (nature-cycle nature))))

;; Human interaction with plants
(defun human-farm (human plant)
  (incf (human-productivity human) (plant-growth plant))
  (decf (plant-health plant) 5)
  (format t "~%~a farms ~a → Productivity: ~a | Plant health: ~a"
          (human-name human) (plant-species plant)
          (human-productivity human) (plant-health plant)))

;; Animal as messenger of spirits
(defun animal-message (animal spirit)
  (format t "~%~a delivers message from ~a spirit: ~a"
          (animal-species animal) (spirit-type spirit) (spirit-influence spirit)))

;; Spirit blessing or warning
(defun spirit-intervene (spirit eco)
  (cond
    ((equal (spirit-influence spirit) "blessing")
     (incf (ecosystem-harmony eco) 10)
     (format t "~%Spirit blessing raises harmony to ~a" (ecosystem-harmony eco)))
    ((equal (spirit-influence spirit) "warning")
     (decf (ecosystem-harmony eco) 10)
     (format t "~%Spirit warning lowers harmony to ~a" (ecosystem-harmony eco)))))

;; City expansion effect
(defun expand-city (city eco)
  (incf (city-temples city) 1)
  (decf (ecosystem-harmony eco) 5)
  (format t "~%City expands → Temples: ~a | Harmony: ~a"
          (city-temples city) (ecosystem-harmony eco)))

;; Conflict events triggered by low harmony
(defun check-conflict (eco)
  (let ((harmony (ecosystem-harmony eco)))
    (cond
      ((< harmony 30)
       (format t "~%⚠ Severe imbalance! Drought strikes the rivers, spirits withdraw.")
       (decf (nature-rivers (ecosystem-nature eco)) 20)
       (dolist (p (ecosystem-plants eco))
         (decf (plant-health p) 20))
       (dolist (h (ecosystem-humans eco))
         (decf (human-happiness h) 15)))
      ((< harmony 50)
       (format t "~%⚠ Warning: Spiritual decline. Kami are restless, productivity falls.")
       (dolist (h (ecosystem-humans eco))
         (decf (human-productivity h) 10))
       (dolist (a (ecosystem-animals eco))
         (decf (animal-health a) 10)))
      (t
       (format t "~%✅ Harmony stable, no conflicts this cycle.")))))

;; Full simulation cycle
(defun simulate-world (eco)
  (format t "~%=== Simulation Cycle ===")
  ;; Advance season
  (advance-season (ecosystem-nature eco))
  ;; Human farming
  (dolist (h (ecosystem-humans eco))
    (dolist (p (ecosystem-plants eco))
      (human-farm h p)))
  ;; Animal messages
  (dolist (a (ecosystem-animals eco))
    (dolist (s (ecosystem-spirits eco))
      (animal-message a s)))
  ;; Spirit interventions
  (dolist (s (ecosystem-spirits eco))
    (spirit-intervene s eco))
  ;; City expansion
  (expand-city (ecosystem-city eco) eco)
  ;; Conflict mechanics
  (check-conflict eco)
  (format t "~%Cycle complete → Harmony: ~a"
          (ecosystem-harmony eco)))
