data NeuronKind = Thought | SpiritModulator | IdentityCore
  deriving (Show, Eq)

data Neuron = Neuron
  { neuronId   :: Int
  , neuronKind :: NeuronKind
  , activation :: Double
  , attention  :: Double
  , bias       :: Double
  } deriving (Show)

data Connection = Connection
  { fromId :: Int
  , toId   :: Int
  , weight :: Double
  } deriving (Show)

data NeuralNet = NeuralNet
  { neurons     :: [(Int, Neuron)]
  , connections :: [Connection]
  , nextId      :: Int
  } deriving (Show)

initNet :: NeuralNet
initNet =
  let n0 = Neuron 0 IdentityCore 1.0 1.0 0.0
      n1 = Neuron 1 Thought 0.5 1.0 0.0
      n2 = Neuron 2 Thought 0.2 1.0 0.0
      n3 = Neuron 3 SpiritModulator 0.3 1.0 0.0
      conns =
        [ Connection 0 1 0.8
        , Connection 1 2 0.6
        , Connection 3 0 0.5
        , Connection 0 3 0.4
        ]
  in NeuralNet [(0,n0),(1,n1),(2,n2),(3,n3)] conns 4

------------------------------------------------------------
-- 4. Pulse, Attention, Learning (Pure)
------------------------------------------------------------

pulse :: NeuralNet -> Double -> NeuralNet
pulse net decay =
  let -- 1. Decay
      decayed = map (\(id,n) -> (id, n { activation = max 0 (activation n * decay) }))
                    (neurons net)
      -- 2. Gather contributions
      contribs = foldl' (\acc conn ->
        case (lookup (fromId conn) decayed, lookup (toId conn) decayed) of
          (Just from, Just _to) ->
            let add = activation from * weight conn
            in  (toId conn, add) : acc
          _ -> acc
        ) [] (connections net)
      -- 3. Apply contributions + attention
      updated = map (\(id,n) ->
        let contrib = sum [c | (tid,c) <- contribs, tid == id]
            raw = max 0 contrib
            newAct = min 1 (raw * attention n)
        in (id, n { activation = newAct })
        ) decayed
  in net { neurons = updated }

attentionUpdate :: NeuralNet -> Personality -> Goal -> Era -> NeuralNet
attentionUpdate net pers goal era =
  let attFor n =
        let base = case neuronKind n of
              IdentityCore -> curious pers
              Thought      -> curious pers * 0.8 + calm pers * 0.2
              SpiritModulator -> harmonic pers
            goalBias = case goal of
              Growth     -> expansive pers
              Balance    -> harmonic pers
              Exploration-> curious pers
              Harmony    -> calm pers
              Clarity    -> focused pers
            eraBias = case era of
              Roots      -> calm pers
              Branches   -> expansive pers
              Storms     -> bold pers
              Echoes     -> reflective pers
              Harmony    -> harmonic pers
        in (base + goalBias + eraBias) / 3.0
      newNeurons = map (\(id,n) -> (id, n { attention = clamp 0.1 1.0 (attFor n) }))
                     (neurons net)
  in net { neurons = newNeurons }

learn :: NeuralNet -> Double -> NeuralNet
learn net rate =
  let newConns = map (\conn ->
        case (lookup (fromId conn) (neurons net), lookup (toId conn) (neurons net)) of
          (Just from, Just to) ->
            let signal = activation from * activation to
                delta = rate * signal * attention to
                newW = clamp 0.0 2.0 (weight conn + delta)
            in conn { weight = newW }
          _ -> conn
        ) (connections net)
  in net { connections = newConns }

clamp :: Ord a => a -> a -> a -> a
clamp lo hi x = max lo (min hi x)

