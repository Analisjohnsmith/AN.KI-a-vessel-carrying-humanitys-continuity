balanceCheck :: [Layer] -> Bool
balanceCheck layers =
  let out = length $ filter ((== Outward) . layerPolarity) layers
      inn = length layers - out
  in out == inn

data BalanceState = Balanced | Unbalanced deriving (Show, Eq)
data OrbitMode = OrbitOn | OrbitOff deriving (Show, Eq)

