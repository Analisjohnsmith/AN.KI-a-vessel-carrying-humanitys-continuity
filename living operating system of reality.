    Unbalanced,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum OrbitMode {
    OrbitOn,
    OrbitOff,
}

pub fn balance(layers: &[Layer]) -> BalanceState {
    let out = layers
        .iter()
        .filter(|l| l.polarity() == Polarity::Outward)
        .count();
    let inn = layers.len() - out;
    if out == inn {
        BalanceState::Balanced
    } else {
        BalanceState::Unbalanced
    }
}

pub fn orbit_mode(b: BalanceState) -> OrbitMode {
    match b {
        BalanceState::Balanced => OrbitMode::OrbitOn,
        BalanceState::Unbalanced => OrbitMode::OrbitOff,
    }
}

pub struct SimConfig {
    pub decay: f32,
    pub learn_rate: f32,
    pub max_ticks: u64,
}

pub fn run_sim(mut state: EngineState, cfg: SimConfig) -> EngineState {
    for _ in 0..cfg.max_ticks {
        // 1. Attention
        update_attention(
            &mut state.net,
            &state.personality,
            &state.goal,
            &state.era,
        );

        // 2. Pulse
        pulse(&mut state.net, cfg.decay);

        // 3. Learning
        learn(&mut state.net, cfg.learn_rate);

        // 4. Era shift (slow)
        if state.tick % 250 == 0 && state.tick > 0 {
            state.era = state.era.next();
        }

        state.tick += 1;
    }
    state
}

