    """Draw a flat mug with a handle, rotated to face outward."""
    w, h = 0.6, 0.8
    # Rotate mug body
    # We'll draw at origin then rotate and translate
    # body: rounded rectangle
    body = Rectangle((-w/2, -h/2), w, h,
                     facecolor=color, edgecolor=CHARCOAL, linewidth=2.5,
                     transform=plt.matplotlib.transforms.Affine2D().rotate(angle).translate(cx, cy) + ax.transData)
    ax.add_patch(body)

    # Handle: a loop that spirals outward (integrated fractal)
    # We'll draw a small arc from the side of the mug that continues as a spiral.
    # However, the handle is already part of the spiral; we just draw a small loop.
