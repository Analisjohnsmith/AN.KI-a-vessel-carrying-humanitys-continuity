import matplotlib
matplotlib.use('Agg')  # terminal-friendly, no GUI

import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle, Ellipse, Circle
import math

# -------------------------------
# Utility functions
# -------------------------------

def jitter(arr, amount=0.008):
    """Add small random jitter for beatnik hand-drawn feel."""
    return arr + np.random.uniform(-amount, amount, size=arr.shape)

def rotate_xy(x, y, angle):
    """Rotate coordinates by angle (radians)."""
    c, s = np.cos(angle), np.sin(angle)
    return c*x - s*y, s*x + c*y

# -------------------------------
# Color palette
# -------------------------------

BG_COLOR = '#0A0C18'            # deep cosmic background
CHARCOAL = '#1A1A1A'            # bold outlines

# Drink colors (subtle cues)
MATCHA   = '#7A8450'            # dusty olive
JAVA     = '#3B2F2F'            # ink brown
CHOCO    = '#8C6A4A'            # muted cocoa

# Dragon torus blues
DRAGON_DEEP  = '#0A1A4F'
DRAGON_MID   = '#1E90FF'
DRAGON_LIGHT = '#3AB6C5'

# Hazelnut
HAZELNUT_FILL = '#7B4B2A'
LEAF_FILL     = '#6B8E23'

# Glyph markers (small accents)
GLYPH_TRUTH = '✦'
GLYPH_DISHARM = '⟡'
GLYPH_PULSE = '⟁'

# -------------------------------
# 1. Logarithmic spiral triskelion
# -------------------------------

def log_spiral_arm(theta, a=0.3, b=0.3):
    """Logarithmic spiral: r = a * exp(b * theta)"""
    return a * np.exp(b * theta)

def generate_spiral_points(theta_start, theta_end, num_points, a=0.3, b=0.3, phase=0):
    """Generate (x,y) points for one spiral arm with given phase."""
    theta = np.linspace(theta_start, theta_end, num_points)
    r = log_spiral_arm(theta, a, b)
    x = r * np.cos(theta + phase)
    y = r * np.sin(theta + phase)
    return x, y

def draw_spiral_triskelion(ax, center=(0,0), radius=2.0, a=0.3, b=0.25, num_points=300):
    """Draw three logarithmic spirals separated by 120°."""
    angles = [0, 2*np.pi/3, 4*np.pi/3]
    colors = [MATCHA, JAVA, CHOCO]
    # colors correspond to matcha, java, choco (order doesn't matter; we'll assign mugs later)
    # but we'll assign each spiral to a mug position later.

    # We'll store the spiral points for each arm.
    spirals = []
    for i, phase in enumerate(angles):
        # Start at inner radius, spiral outward.
        t_start = 0.0
        t_end = 6 * np.pi  # about 3 full rotations
        x, y = generate_spiral_points(t_start, t_end, num_points, a, b, phase)
        # Scale to fit within radius
        max_r = np.max(np.sqrt(x**2 + y**2))
        scale = radius / max_r if max_r > 0 else 1
        x *= scale
        y *= scale
        # Add jitter
        x = jitter(x, 0.01)
        y = jitter(y, 0.01)
        spirals.append((x, y, colors[i % len(colors)]))
        # Plot each spiral with its color
        ax.plot(x, y, color=colors[i % len(colors)], linewidth=2.5, alpha=0.9)
        # Add some glyph markers at intervals (42° pulse)
        pulse_angle = np.deg2rad(42)
        for t in np.arange(0, t_end, pulse_angle):
            rr = log_spiral_arm(t, a, b) * scale
            xx = rr * np.cos(t + phase)
            yy = rr * np.sin(t + phase)
            # Only if within radius
            if np.sqrt(xx**2 + yy**2) < radius * 0.95:
                marker = GLYPH_PULSE if (t // pulse_angle) % 2 == 0 else GLYPH_TRUTH
                ax.text(xx, yy, marker, fontsize=6, color=CHARCOAL, ha='center', va='center')
    return spirals

# -------------------------------
# 2. Flat mugs with fractal handles
# -------------------------------

def draw_mug(ax, cx, cy, angle, color, label):
    """Draw a flat mug with a handle, rotated to face outward."""
    w, h = 0.6, 0.8
    # Rotate mug body
    # We'll draw at origin then rotate and translate
    # body: rounded rectangle
    body = Rectangle((-w/2, -h/2), w, h,
                     facecolor=color, edgecolor=CHARCOAL, linewidth=2.5,
                     transform=plt.matplotlib.transforms.Affine2D().rotate(angle).translate(cx, cy) + ax.transData)
    ax.add_patch(body)

    # Handle: a loop that spirals outward (integrated fractal)
    # We'll draw a small arc from the side of the mug that continues as a spiral.
    # However, the handle is already part of the spiral; we just draw a small loop.
    # For simplicity, we'll add a semicircular handle that touches the mug.
    # But to match the "handles as fractal arms", we'll make the handle the start of the spiral.
    # Since the spiral is drawn separately, we'll just put a small handle indicator.
    # Actually we'll draw a simple curved handle.
    theta_handle = np.linspace(0, np.pi, 30)
    r_handle = 0.2
    hx = r_handle * np.cos(theta_handle) + w/2 + 0.05
    hy = r_handle * np.sin(theta_handle)
    # Rotate and translate
    hx_rot, hy_rot = rotate_xy(hx, hy, angle)
    hx_rot += cx
    hy_rot += cy
    ax.plot(hx_rot, hy_rot, color=CHARCOAL, linewidth=3)

    # Decoration on mug to hint at drink
    if label == 'Java':
        # small coffee bean glyph
        bean = Ellipse((0, 0), 0.15, 0.2, facecolor='#2A1E1A', edgecolor=CHARCOAL, linewidth=1.5)
        bean_rot = plt.matplotlib.transforms.Affine2D().rotate(angle).translate(cx, cy)
        bean.set_transform(bean_rot + ax.transData)
        ax.add_patch(bean)
        # Also add a little steam
        ax.plot([cx-0.1, cx-0.2], [cy+0.4, cy+0.55], color='white', linewidth=1.5, alpha=0.5)
    elif label == 'Hot Chocolate':
        # cocoa dots
        for dx, dy in [(-0.1,0.1), (0.1,0.1), (0, -0.05)]:
            dot = Circle((cx + dx, cy + dy), 0.04, facecolor='#5D3A1A', edgecolor=CHARCOAL)
            ax.add_patch(dot)
    elif label == 'Matcha':
        # leaf swirl
        leaf = Ellipse((0, 0), 0.15, 0.08, facecolor='#5A7A3A', edgecolor=CHARCOAL, linewidth=1.5)
        leaf_rot = plt.matplotlib.transforms.Affine2D().rotate(angle + np.pi/4).translate(cx, cy)
        leaf.set_transform(leaf_rot + ax.transData)
        ax.add_patch(leaf)
        # steam lines
        ax.plot([cx-0.05, cx-0.1], [cy+0.4, cy+0.6], color='white', linewidth=1.5, alpha=0.5)
        ax.plot([cx+0.05, cx+0.1], [cy+0.4, cy+0.6], color='white', linewidth=1.5, alpha=0.5)

# -------------------------------
# 3. Blue dragon torus (cosmos)
# -------------------------------

def draw_dragon_torus(ax, R=3.2, r=0.8, num_u=150, num_v=30):
    """Draw a cosmic blue dragon torus as outer boundary."""
    u = np.linspace(0, 2*np.pi, num_u)
    v = np.linspace(0, 2*np.pi, num_v)
    u, v = np.meshgrid(u, v)

    x = (R + r * np.cos(v)) * np.cos(u)
    y = (R + r * np.cos(v)) * np.sin(u)

    # Dragon modulation: scales + 42° pulse
    pulse = np.deg2rad(42)
    scale = 1 + 0.08 * np.sin(6 * u + pulse)
    x *= scale
    y *= scale

    # Color gradient along u (deep to light blue)
    t = (u - u.min()) / (u.max() - u.min())
    # Interpolate RGB
    Rc = 10 + t * (30 - 10)
    Gc = 26 + t * (144 - 26)
    Bc = 79 + t * (255 - 79)
    Rn = Rc / 255.0
    Gn = Gc / 255.0
    Bn = Bc / 255.0

    for i in range(x.shape[0]):
        ax.plot(x[i, :], y[i, :],
                color=(Rn[i, 0], Gn[i, 0], Bn[i, 0]),
                linewidth=1.2, alpha=0.7)

    # Dragon head (a stylized ellipse at one point)
    head_angle = 0.2  # slightly offset
    hx = (R + r + 0.15) * np.cos(head_angle)
    hy = (R + r + 0.15) * np.sin(head_angle)
    head = Ellipse((hx, hy), 0.5, 0.3, facecolor=DRAGON_LIGHT, edgecolor='white', linewidth=2)
    ax.add_patch(head)
    # Eye dot
    eye = Circle((hx + 0.15, hy + 0.05), 0.07, facecolor='white', edgecolor='black')
    ax.add_patch(eye)

    # Add cosmic glyphs along torus
    for ang in np.linspace(0, 2*np.pi, 12):
        xx = (R + 0.1) * np.cos(ang)
        yy = (R + 0.1) * np.sin(ang)
        if np.random.rand() > 0.5:
            ax.text(xx, yy, '∞', fontsize=12, color='white', alpha=0.4, ha='center', va='center')

# -------------------------------
# 4. Hazelnut seed (center)
# -------------------------------

def draw_hazelnut(ax):
    nut = Ellipse((0, 0), 0.3, 0.45, facecolor=HAZELNUT_FILL, edgecolor=CHARCOAL, linewidth=3)
    leaf = Ellipse((0, 0.25), 0.15, 0.08, facecolor=LEAF_FILL, edgecolor=CHARCOAL, linewidth=2)
    ax.add_patch(nut)
    ax.add_patch(leaf)
    # Add glyph on nut
    ax.text(0, 0, 'Λ', fontsize=18, color='white', ha='center', va='center', fontweight='bold')

# -------------------------------
# 5. Background stars
# -------------------------------

def draw_stars(ax, n=200):
    for _ in range(n):
        x = np.random.uniform(-4.5, 4.5)
        y = np.random.uniform(-4.5, 4.5)
        size = np.random.uniform(1, 4)
        alpha = np.random.uniform(0.1, 0.7)
        ax.plot(x, y, 'w.', markersize=size, alpha=alpha)

# -------------------------------
# Main composition
# -------------------------------

def generate_logo():
    fig, ax = plt.subplots(figsize=(10, 10))
    ax.set_aspect('equal')
    ax.set_facecolor(BG_COLOR)
    ax.axis('off')
    ax.set_xlim(-4.5, 4.5)
    ax.set_ylim(-4.5, 4.5)

    # 1. Background stars
    draw_stars(ax, 180)

    # 2. Dragon torus (outer cosmos)
    draw_dragon_torus(ax, R=3.4, r=0.9)

    # 3. Spirals (triskelion)
    # Place mugs at 120° intervals on a circle of radius 1.8
    mug_positions = [ (1.8, 0, 0),          # angle 0
                      (1.8*np.cos(2*np.pi/3), 1.8*np.sin(2*np.pi/3), 2*np.pi/3),
                      (1.8*np.cos(4*np.pi/3), 1.8*np.sin(4*np.pi/3), 4*np.pi/3) ]
    drink_labels = ['Java', 'Hot Chocolate', 'Matcha']
    drink_colors = [JAVA, CHOCO, MATCHA]

    # Draw spirals first (behind mugs)
    spiral_radius = 2.2
    # We'll draw three spirals with phases corresponding to mug angles
    # but shifted so they emanate from the mug handles.
    # For each mug, the spiral starts at its handle and spirals outward.
    # We'll generate each spiral from a starting point near the mug.
    # To keep it simple, we'll draw three spirals centered at origin,
    # but each phase matches the mug angle, and we offset them.
    # We already have draw_spiral_triskelion, but we need to adjust so that
    # each spiral appears to emerge from the mug handle.

    # We'll create custom spirals per mug.
    for i, (cx, cy, ang) in enumerate(mug_positions):
        # Determine starting point for spiral: just outside the mug handle
        # The handle is on the outer side of the mug, we'll set start at (cx + 0.4, cy) rotated.
        start_x = cx + 0.5 * np.cos(ang)
        start_y = cy + 0.5 * np.sin(ang)
        # Generate logarithmic spiral starting from that point
        # We'll use polar coordinates relative to (0,0) but we can also shift.
        # Better: generate a spiral that grows from (start_x, start_y) outward.
        # We'll use a logarithmic spiral centered at (0,0) but phase adjusted to pass through (start_x, start_y).
        # Calculate the angle of the start point from origin:
        theta_start = np.arctan2(start_y, start_x)
        r_start = np.sqrt(start_x**2 + start_y**2)
        # Adjust parameters to ensure the spiral passes through (r_start, theta_start)
        # We'll just use a spiral that starts at a small radius and grows, then shift the phase.
        # Easiest: draw the triskelion as before, but each spiral's phase is the mug angle + some offset.
        # We already have a function; we'll use that and the spirals will be drawn from center outward.
        # To make it look like they emerge from the mugs, we can start the spiral at the mug radius.
        # So we'll draw spiral arms that start at radius ~1.8.
        # We'll generate points for each arm with a phase equal to the mug angle.
        # We'll also add a small jitter and a handle-like arc at the start.
        # Let's just use the existing draw_spiral_triskelion but with custom phases and starting radii.
        pass

    # Instead, we'll implement a simpler approach: draw three spirals originating from each mug position.
    # We'll define a function to draw a spiral from a given point.
    # But to keep code concise, we'll use the generic triskelion and then overlay the mugs.
    # We'll draw the triskelion centered at origin, then place mugs at the inner ends.

    # We'll draw spirals first (from center outward)
    # Use the draw_spiral_triskelion function with radius=2.0
    spirals = draw_spiral_triskelion(ax, center=(0,0), radius=2.2, a=0.3, b=0.25)

    # Now draw the mugs on top, positioned at the inner ends of the spirals.
    # The inner ends of the spirals are at radius ~ a*scale, but we'll place mugs at 1.8.
    for i, (cx, cy, ang) in enumerate(mug_positions):
        color = drink_colors[i]
        label = drink_labels[i]
        draw_mug(ax, cx, cy, ang, color, label)

    # 4. Hazelnut seed center
    draw_hazelnut(ax)

    # 5. Add JAVΛ42™ title text at bottom
    ax.text(0, -4.2, 'JAVΛ42™', fontsize=28, color='white', ha='center', va='center',
            fontweight='bold', fontfamily='sans-serif')
    ax.text(0, -4.6, 'bones · breath · logic in motion', fontsize=12, color='#88AACC', ha='center', va='center',
            fontstyle='italic')

    # 6. Add small glyph legend
    ax.text(4.0, -3.8, '✦ Truth  ⟡ Disharmony  ⟁ Pulse', fontsize=10, color='#8899BB', ha='right', va='center')

    plt.tight_layout()
    plt.savefig('jav_logo.png', dpi=300, bbox_inches='tight', facecolor=BG_COLOR)
    print("✅ Logo saved as jav_logo.png")

if __name__ == "__main__":
    generate_logo()
