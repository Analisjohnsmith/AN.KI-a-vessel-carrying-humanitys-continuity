    # Color gradient along u (deep to light blue)
    t = (u - u.min()) / (u.max() - u.min())
    # Interpolate RGB
    Rc = 10 + t * (30 - 10)
    Gc = 26 + t * (144 - 26)
    Bc = 79 + t * (255 - 79)
    Rn = Rc / 255.0
    Gn = Gc / 255.0
