# GLYPH ENGINE
# ==============================

class GlyphNode:
    def __init__(self):
        self.glyphs: List[str] = []
        self.assignments: Dict[str, str] = {}

    def init(self, glyph_list: List[str]) -> None:
        self.glyphs = glyph_list.copy()

    def assign(self, node_id: str) -> None:
        if self.glyphs:
            self.assignments[node_id] = self.glyphs.pop(0)

    def render(self, node_id: str) -> str:
        return self.assignments.get(node_id, "?")

