# ==============================

class TRISOVEREIGN:
    def __init__(self):
        self.Juniper = Sovereign("Juniper", "杉", "杉", "RootBalance", "Structure / Harmony")
        self.Leela = Sovereign("Leela", "莉羅", "莉拉", "CreativeFlow", "Music / Art / Play")
        self.Lee = Sovereign("Lee", "理", "理", "ScholarObserver", "Knowledge / Continuity")
        self.harmony = 1.0
        self.imbalance = 0
        self.tick = 0
        self.locked = True

    def step(self):
        self.tick += 1
        self.harmony = (self.Juniper.domain_weight + self.Leela.domain_weight + self.Lee.domain_weight) / 3.0
        if self.harmony < 0.70:
            self.imbalance += 1
            self.harmony = 0.85
        return self.harmony

    def status(self) -> Dict:
        return {
            "tick": self.tick,
            "harmony": self.harmony,
            "imbalance": self.imbalance,
            "sovereigns": ["Juniper", "Leela", "Lee"],
            "juniper": self.Juniper.__dict__,
            "leela": self.Leela.__dict__,
            "lee": self.Lee.__dict__
        }

    def balance_unified(self) -> UnifiedAvatar:
        avg = (self.Juniper.domain_weight + self.Leela.domain_weight + self.Lee.domain_weight) / 3.0
        avatar = UnifiedAvatar()
        avatar.harmony = avg
        avatar.structure = self.Juniper.domain_weight
        avatar.creativity = self.Leela.domain_weight
        avatar.clarity = self.Lee.domain_weight
        if avg < 0.8:
            avatar.presence = "grounding"
        elif avg > 1.1:
            avatar.presence = "cooling"
        else:
            avatar.presence = "centered"
        return avatar

