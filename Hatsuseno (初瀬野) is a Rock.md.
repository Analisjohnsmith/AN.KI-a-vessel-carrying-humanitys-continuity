#[derive(Debug, Serialize, Deserialize, Clone)]
pub struct User {
    pub user_id: String,
    pub meta: HashMap<String, String>,
}

#[derive(Debug, Serialize, Deserialize, Clone)]
pub struct Session {
    pub session_id: String,
    pub user_id: String,
    pub created_at: u64,
}

#[derive(Debug, Default)]
pub struct IdentityManager {
    pub users: HashMap<String, User>,
    pub sessions: HashMap<String, Session>,
}

impl IdentityManager {
    pub fn create_user(&mut self, user_id: &str, meta: HashMap<String, String>) -> Result<User> {
        if self.users.contains_key(user_id) {
            return Err(AuriraError(format!("user exists: {}", user_id)));
        }
        let u = User {
            user_id: user_id.to_string(),
            meta,
        };
        self.users.insert(user_id.to_string(), u.clone());
        Ok(u)
    }

    pub fn create_session(&mut self, user_id: &str) -> Result<Session> {
        if !self.users.contains_key(user_id) {
            return Err(AuriraError(format!("user not found: {}", user_id)));
        }
        let sid = format!("s_{}_{}", user_id, Uuid::new_v4());
        let s = Session {
            session_id: sid.clone(),
            user_id: user_id.to_string(),
            created_at: now_ts(),
        };
        self.sessions.insert(sid.clone(), s.clone());
        Ok(s)
    }

    pub fn get_session_user(&self, session_id: &str) -> Result<User> {
        let s = self
            .sessions
            .get(session_id)
            .ok_or_else(|| AuriraError(format!("session not found: {}", session_id)))?;
        let u = self
            .users
            .get(&s.user_id)
            .ok_or_else(|| AuriraError(format!("user not found: {}", s.user_id)))?;
        Ok(u.clone())
    }
}

