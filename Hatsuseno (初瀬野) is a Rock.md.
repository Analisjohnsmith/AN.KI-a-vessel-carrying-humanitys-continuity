BOOKVM: |
  // Minimal Book Virtual Machine
  typedef struct { uint8_t cells[80][25]; } Grid;
  typedef struct { int x,y,dx,dy; Stack s; } Pointer;
  Grid* bookvm_alloc() { return mmap(4096); }
  void bookvm_exec(Pointer* p, Grid* g) {
    while(p->alive) {
      uint8_t instr = g->cells[p->y][p->x];
      switch(instr) {
        case '>': p->dx=1; p->dy=0; break;
        case '<': p->dx=-1; p->dy=0; break;
        case 'v': p->dx=0; p->dy=1; break;
        case '^': p->dx=0; p->dy=-1; break;
        case '@': p->alive=0; break;
        case 'g': { int y=pop(p); int x=pop(p);
                   push(p, g->cells[y][x]); } break;
        case 'p': { int y=pop(p); int x=pop(p);
                   g->cells[y][x]=pop(p); } break;
        default: if(instr>='0'&&instr<='9')
                   push(p, instr-'0');
      }
      p->x+=p->dx; p->y+=p->dy;
    }
  }

