  void execute_step(Pointer* p) {
    uint8_t c = grid[p->y][p->x];
    switch(c) {
      case '>': p->dx=1; p->dy=0; break;
      case '<': p->dx=-1; p->dy=0; break;
      case '^': p->dx=0; p->dy=-1; break;
      case 'v': p->dx=0; p->dy=1; break;
      case '.': print_int(pop(p)); break;
      case ',': print_char(pop(p)); break;
      case '&': push(p, read_int()); break;
      case '~': push(p, read_char()); break;
      case '@': p->alive=0; break;
      case '"': p->string_mode=!p->string_mode; break;
      default: if(p->string_mode) push(p,c);
               else if(c>='0'&&c<='9') push(p,c-'0');
    }
    p->x+=p->dx; if(p->x>=W)p->x=0; if(p->x<0)p->x=W-1;
