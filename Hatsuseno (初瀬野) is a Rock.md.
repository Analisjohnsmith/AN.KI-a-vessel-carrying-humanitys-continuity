            .endpoints
            .get_mut(endpoint_id)
            .ok_or_else(|| AuriraError(format!("endpoint not found: {}", endpoint_id)))?;
        ep.messages.push(IpcMessage {
            ts: now_ts(),
            msg,
        });
        Ok(())
    }

