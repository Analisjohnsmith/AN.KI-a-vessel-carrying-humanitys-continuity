        let ep = self
            .endpoints
            .get_mut(endpoint_id)
            .ok_or_else(|| AuriraError(format!("endpoint not found: {}", endpoint_id)))?;
        let msgs = ep.messages.clone();
        ep.messages.clear();
        Ok(msgs)
    }
}

