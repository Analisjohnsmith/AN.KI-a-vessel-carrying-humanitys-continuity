impl AuriraPlatformUnified {
    pub fn new(hzl_meta: HZLUnified) -> Self {
        Self {
            identity: IdentityManager::default(),
            resources: ResourceManager::default(),
            spaces: SpaceManager::default(),
            tasks: TaskManager::default(),
            drivers: DriverManager::default(),
            ipc: IpcManager::default(),
            security: SecurityManager::default(),
            apps: AppManager::default(),
            ui: UiManager::default(),
            installer: InstallerManager::default(),
            kernel: KernelManager::default(),
            semantic_graph: SemanticGraph::default(),
            hzl_meta,
        }
    }

    pub fn create_user(
        &mut self,
        user_id: &str,
        meta: HashMap<String, String>,
    ) -> Result<User> {
        self.identity.create_user(user_id, meta)
    }

    pub fn login(&mut self, user_id: &str) -> Result<String> {
        Ok(self.identity.create_session(user_id)?.session_id)
    }

    pub fn open_space(&mut self, session_id: &str) -> Result<String> {
        let user = self.identity.get_session_user(session_id)?;
        Ok(self.spaces.create_space(&user.user_id).space_id)
    }

    pub fn write(
        &mut self,
        session_id: &str,
        space_id: &str,
        key: &str,
        value: serde_json::Value,
    ) -> Result<()> {
        let user = self.identity.get_session_user(session_id)?;
        let quota_key = format!("{}:writes", user.user_id);
        self.resources.consume(&quota_key, 1)?;
        self.spaces.write(space_id, key, value)
    }

    pub fn spawn_task(
        &mut self,
        session_id: &str,
        payload: serde_json::Value,
    ) -> Result<String> {
        let user = self.identity.get_session_user(session_id)?;
        Ok(self.tasks.spawn_task(&user.user_id, payload).task_id)
    }

    pub fn tick(&mut self) {
        self.kernel.tick();
    }

    pub fn snapshot(&self) -> serde_json::Value {
        serde_json::json!({
            "users": self.identity.users.keys().collect::<Vec<_>>(),
            "sessions": self.identity.sessions.keys().collect::<Vec<_>>(),
            "spaces": self.spaces.spaces.keys().collect::<Vec<_>>(),
            "tasks": self.tasks.tasks.keys().collect::<Vec<_>>(),
            "drivers": self.drivers.drivers.iter().map(|(id, (d, _))| {
                (id.clone(), serde_json::json!({"name": d.name, "kind": d.kind}))
            }).collect::<HashMap<_,_>>(),
            "ipc_endpoints": self.ipc.endpoints.keys().collect::<Vec<_>>(),
            "apps": self.apps.apps.keys().collect::<Vec<_>>(),
            "windows": self.ui.windows.keys().collect::<Vec<_>>(),
            "version": self.installer.current_version,
            "kernel_ticks": self.kernel.ticks,
            "hzl_meta": &self.hzl_meta,
        })
    }
}

