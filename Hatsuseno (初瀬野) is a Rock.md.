# aurira_unified_platform.py

from __future__ import annotations
from dataclasses import dataclass, field
from typing import Dict, Any, Optional, List, Callable
import time
import uuid


class AuriraError(Exception):
    pass


# ---------- Identity / Sessions ----------

@dataclass
class User:
    user_id: str
    meta: Dict[str, Any] = field(default_factory=dict)


@dataclass
class Session:
    session_id: str
    user_id: str
    created_at: float


class IdentityManager:
    def __init__(self) -> None:
        self.users: Dict[str, User] = {}
        self.sessions: Dict[str, Session] = {}

    def create_user(self, user_id: str, meta: Optional[Dict[str, Any]] = None) -> User:
        if user_id in self.users:
            raise AuriraError(f"user exists: {user_id}")
        u = User(user_id=user_id, meta=meta or {})
        self.users[user_id] = u
        return u

    def create_session(self, user_id: str) -> Session:
        if user_id not in self.users:
            raise AuriraError(f"user not found: {user_id}")
        sid = f"s_{user_id}_{uuid.uuid4().hex}"
        s = Session(session_id=sid, user_id=user_id, created_at=time.time())
        self.sessions[sid] = s
        return s

    def get_session_user(self, session_id: str) -> User:
        s = self.sessions[session_id]
        return self.users[s.user_id]


# ---------- Resources ----------

class ResourceManager:
    def __init__(self) -> None:
        self.quotas: Dict[str, int] = {}
        self.usage: Dict[str, int] = {}

    def set_quota(self, key: str, value: int) -> None:
        self.quotas[key] = value

    def consume(self, key: str, amount: int = 1) -> None:
        q = self.quotas.get(key)
        u = self.usage.get(key, 0)
        if q is not None and u + amount > q:
            raise AuriraError(f"quota exceeded: {key}")
        self.usage[key] = u + amount


# ---------- Spaces ----------

@dataclass
class Space:
    space_id: str
    owner_user_id: str
    created_at: float
    items: Dict[str, Any] = field(default_factory=dict)


class SpaceManager:
    def __init__(self) -> None:
        self.spaces: Dict[str, Space] = {}

    def create_space(self, owner_user_id: str) -> Space:
        sid = f"space_{uuid.uuid4().hex}"
        sp = Space(space_id=sid, owner_user_id=owner_user_id, created_at=time.time())
        self.spaces[sid] = sp
        return sp

    def write(self, space_id: str, key: str, value: Any) -> None:
        sp = self.spaces[space_id]
        sp.items[key] = value


# ---------- Tasks ----------

@dataclass
class Task:
    task_id: str
    user_id: str
    payload: Dict[str, Any]
    created_at: float
    status: str = "pending"


class TaskManager:
    def __init__(self) -> None:
        self.tasks: Dict[str, Task] = {}

    def spawn_task(self, user_id: str, payload: Dict[str, Any]) -> Task:
        tid = f"task_{uuid.uuid4().hex}"
        t = Task(task_id=tid, user_id=user_id, payload=payload, created_at=time.time())
        self.tasks[tid] = t
        return t


# ---------- Drivers / HAL ----------

@dataclass
class Driver:
    driver_id: str
    name: str
    kind: str
    meta: Dict[str, Any]
    handler: Optional[Callable[[str, Dict[str, Any]], Any]] = None


class DriverManager:
    """
    This is where HAL + higher-level drivers plug in:
    - kind="gpu", "net", "storage", "sensor", "ui", "fs", etc.
    """
    def __init__(self) -> None:
        self.drivers: Dict[str, Driver] = {}

    def register_driver(
        self,
        name: str,
        kind: str,
        meta: Optional[Dict[str, Any]] = None,
        handler: Optional[Callable[[str, Dict[str, Any]], Any]] = None,
    ) -> Driver:
        did = f"drv_{name}_{uuid.uuid4().hex}"
        d = Driver(driver_id=did, name=name, kind=kind, meta=meta or {}, handler=handler)
        self.drivers[did] = d
        return d

    def call(self, driver_id: str, op: str, args: Dict[str, Any]) -> Any:
        d = self.drivers[driver_id]
        if d.handler is None:
            return {"driver": d.name, "kind": d.kind, "op": op, "args": args, "status": "noop"}
        return d.handler(op, args)


# ---------- IPC ----------

@dataclass
class IpcEndpoint:
    endpoint_id: str
    name: str
    messages: List[Any] = field(default_factory=list)


class IpcManager:
    def __init__(self) -> None:
        self.endpoints: Dict[str, IpcEndpoint] = {}

    def create_endpoint(self, name: str) -> IpcEndpoint:
        eid = f"ep_{name}_{uuid.uuid4().hex}"
        ep = IpcEndpoint(endpoint_id=eid, name=name)
        self.endpoints[eid] = ep
        return ep

    def send(self, endpoint_id: str, msg: Any) -> None:
        ep = self.endpoints[endpoint_id]
        ep.messages.append({"ts": time.time(), "msg": msg})

    def drain(self, endpoint_id: str) -> List[Any]:
        ep = self.endpoints[endpoint_id]
        msgs = ep.messages[:]
        ep.messages.clear()
        return msgs


# ---------- Security ----------

class SecurityManager:
    """
    Placeholder surface for:
    - keychain
    - permissions
    - sandbox checks
    """
    def __init__(self) -> None:
        self.permissions: Dict[str, List[str]] = {}  # app_id -> [perm]

    def set_permissions(self, app_id: str, perms: List[str]) -> None:
        self.permissions[app_id] = perms

    def check_permission(self, app_id: str, perm: str) -> bool:
        return perm in self.permissions.get(app_id, [])


# ---------- Apps / Runtime ----------

@dataclass
class App:
    app_id: str
    owner_user_id: str
    manifest: Dict[str, Any]


class AppManager:
    """
    Surface for:
    - app registration
    - manifests
    - packaging hooks
    """
    def __init__(self) -> None:
        self.apps: Dict[str, App] = {}

    def register_app(self, owner_user_id: str, manifest: Dict[str, Any]) -> App:
        aid = manifest.get("id") or f"app_{uuid.uuid4().hex}"
        app = App(app_id=aid, owner_user_id=owner_user_id, manifest=manifest)
        self.apps[aid] = app
        return app


# ---------- UI System ----------

class UiManager:
    """
    Surface for:
    - windows
    - views
    - input routing
    - composition
    """
    def __init__(self) -> None:
        self.windows: Dict[str, Dict[str, Any]] = {}

    def create_window(self, owner_user_id: str, title: str) -> str:
        wid = f"win_{uuid.uuid4().hex}"
        self.windows[wid] = {"owner": owner_user_id, "title": title, "views": []}
        return wid


# ---------- Installer / Updater ----------

class InstallerManager:
    """
    Surface for:
    - system updates
    - rollback
    - version tracking
    """
    def __init__(self) -> None:
        self.current_version: str = "0.0.1"
        self.history: List[str] = [self.current_version]

    def update_to(self, version: str) -> None:
        self.current_version = version
        self.history.append(version)


# ---------- Kernel / Scheduler Surface ----------

class KernelManager:
    """
    Surface for:
    - scheduling policy
    - process model hooks
    - priority classes
    """
    def __init__(self) -> None:
        self.ticks: int = 0

    def tick(self) -> None:
        self.ticks += 1
        # hook: scheduling, timeouts, etc.


# ---------- Unified Aurīra Platform ----------

class AuriraPlatformUnified:
    """
    Unified Aurīra PLATFORM (not just core):

    Organs:
    - identity
    - resources
    - spaces
    - tasks
    - drivers (HAL + higher)
    - IPC
    - security
    - apps
    - UI
    - installer
    - kernel surface
    """

    def __init__(self) -> None:
        self.identity = IdentityManager()
        self.resources = ResourceManager()
        self.spaces = SpaceManager()
        self.tasks = TaskManager()
        self.drivers = DriverManager()
        self.ipc = IpcManager()
        self.security = SecurityManager()
        self.apps = AppManager()
        self.ui = UiManager()
        self.installer = InstallerManager()
        self.kernel = KernelManager()

    # convenience methods

    def create_user(self, user_id: str, meta: Optional[Dict[str, Any]] = None) -> User:
        return self.identity.create_user(user_id, meta)

    def login(self, user_id: str) -> str:
        return self.identity.create_session(user_id).session_id

    def open_space(self, session_id: str) -> str:
        user = self.identity.get_session_user(session_id)
        return self.spaces.create_space(user.user_id).space_id

    def write(self, session_id: str, space_id: str, key: str, value: Any) -> None:
        user = self.identity.get_session_user(session_id)
        self.resources.consume(f"{user.user_id}:writes", 1)
        self.spaces.write(space_id, key, value)

    def spawn_task(self, session_id: str, payload: Dict[str, Any]) -> str:
        user = self.identity.get_session_user(session_id)
        return self.tasks.spawn_task(user.user_id, payload).task_id

    def tick(self) -> None:
        self.kernel.tick()

    def snapshot(self) -> Dict[str, Any]:
        return {
            "users": list(self.identity.users.keys()),
            "sessions": list(self.identity.sessions.keys()),
            "spaces": list(self.spaces.spaces.keys()),
            "tasks": list(self.tasks.tasks.keys()),
            "drivers": {d.driver_id: {"name": d.name, "kind": d.kind} for d in self.drivers.drivers.values()},
            "ipc_endpoints": list(self.ipc.endpoints.keys()),
            "apps": list(self.apps.apps.keys()),
            "windows": list(self.ui.windows.keys()),
            "version": self.installer.current_version,
            "kernel_ticks": self.kernel.ticks,
        }


