#include <stdint.h>
#include "vga_text.h"

#define VGA_MEM ((uint16_t*)0xB8000)
static int cursor_x = 0, cursor_y = 0;

static void vga_put_entry(char c, uint8_t color, int x, int y) {
    VGA_MEM[y * 80 + x] = ((uint16_t)color << 8) | (uint8_t)c;
}

void vga_clear(void) {
    for (int y = 0; y < 25; y++)
        for (int x = 0; x < 80; x++)
            vga_put_entry(' ', 0x07, x, y);
    cursor_x = cursor_y = 0;
}

void vga_putc(char c) {
    if (c == '\n') {
        cursor_x = 0;
        cursor_y++;
    } else {
        vga_put_entry(c, 0x07, cursor_x, cursor_y);
        cursor_x++;
        if (cursor_x >= 80) {
            cursor_x = 0;
            cursor_y++;
        }
    }
}

void vga_print(const char *s) {
    while (*s) vga_putc(*s++);
}

void vga_print_int(int v) {
    char buf[16];
    int i = 0;
    if (v == 0) { vga_putc('0'); return; }
    if (v < 0) { vga_putc('-'); v = -v; }
    while (v > 0 && i < 15) {
        buf[i++] = '0' + (v % 10);
        v /= 10;
    }
    while (i--) vga_putc(buf[i]);
}

