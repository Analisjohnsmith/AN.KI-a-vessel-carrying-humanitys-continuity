    pub fn set_quota(&mut self, key: &str, value: i64) {
        self.quotas.insert(key.to_string(), value);
    }

    pub fn consume(&mut self, key: &str, amount: i64) -> Result<()> {
        let q = self.quotas.get(key).cloned();
        let u = self.usage.get(key).cloned().unwrap_or(0);
        if let Some(limit) = q {
            if u + amount > limit {
                return Err(AuriraError(format!("quota exceeded: {}", key)));
            }
        }
        self.usage.insert(key.to_string(), u + amount);
        Ok(())
    }
}

