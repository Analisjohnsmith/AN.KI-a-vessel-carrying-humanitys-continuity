    pub name: String,
    pub kind: String,
    pub meta: HashMap<String, String>,
}

pub type DriverHandler =
    fn(op: &str, args: &serde_json::Value) -> serde_json::Value;

#[derive(Debug, Default)]
pub struct DriverManager {
    pub drivers: HashMap<String, (Driver, Option<DriverHandler>)>,
}

impl DriverManager {
    pub fn register_driver(
        &mut self,
        name: &str,
        kind: &str,
        meta: HashMap<String, String>,
        handler: Option<DriverHandler>,
    ) -> Driver {
        let did = format!("drv_{}_{}", name, Uuid::new_v4());
        let d = Driver {
            driver_id: did.clone(),
            name: name.to_string(),
            kind: kind.to_string(),
            meta,
        };
        self.drivers.insert(did.clone(), (d.clone(), handler));
        d
    }

    pub fn call(
        &self,
        driver_id: &str,
        op: &str,
        args: &serde_json::Value,
    ) -> Result<serde_json::Value> {
        let (d, handler) = self
            .drivers
            .get(driver_id)
            .ok_or_else(|| AuriraError(format!("driver not found: {}", driver_id)))?;
        if let Some(h) = handler {
            Ok(h(op, args))
        } else {
            Ok(serde_json::json!({
                "driver": d.name,
                "kind": d.kind,
                "op": op,
                "args": args,
                "status": "noop"
            }))
        }
    }
}

