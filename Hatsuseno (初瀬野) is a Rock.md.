#include "funge.h"
#include "vga_text.h"

uint8_t grid[H][W];

void stack_push(Stack *s, int32_t v) {
    if (s->sp < STACK_SIZE) s->data[s->sp++] = v;
}

int32_t stack_pop(Stack *s) {
    if (s->sp == 0) return 0;
    return s->data[--s->sp];
}

void funge_init_grid(void) {
    for (int y = 0; y < H; y++)
        for (int x = 0; x < W; x++)
            grid[y][x] = ' ';
}

void funge_load_program(const char *path) {
    // For v1.0: embed a program directly instead of filesystem
    // Example: simple "Hello FungeOS!"
    const char *prog[] = {
        "v>v                                                                            ",
        "  >\"Hello FungeOS!\"v                                                         ",
        "   v,_@                                                                       ",
        "   > ^                                                                        "
    };
    for (int y = 0; y < 4; y++)
        for (int x = 0; x < W; x++)
            grid[y][x] = prog[y][x];
}

void funge_step(Pointer *p) {
    uint8_t c = grid[p->y][p->x];

    if (p->string_mode && c != '"') {
        stack_push(&p->s, c);
    } else {
        switch (c) {
        case '>': p->dx = 1;  p->dy = 0; break;
        case '<': p->dx = -1; p->dy = 0; break;
        case '^': p->dx = 0;  p->dy = -1; break;
        case 'v': p->dx = 0;  p->dy = 1; break;
        case '@': p->alive = 0; break;
        case '"': p->string_mode = !p->string_mode; break;
        case '.': vga_print_int(stack_pop(&p->s)); break;
        case ',': vga_putc((char)stack_pop(&p->s)); break;
        default:
            if (c >= '0' && c <= '9')
                stack_push(&p->s, c - '0');
            break;
        }
    }

    p->x += p->dx;
    if (p->x >= W) p->x = 0;
    if (p->x < 0)  p->x = W - 1;

    p->y += p->dy;
    if (p->y >= H) p->y = 0;
    if (p->y < 0)  p->y = H - 1;
}

void funge_execute(Pointer *p) {
    while (p->alive) {
        funge_step(p);
    }
}

